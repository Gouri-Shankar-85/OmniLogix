<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="kuka_kr16_2">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import kuka_kr16_2 urdf file -->
    <xacro:include filename="$(find kuka_description)/urdf/kuka_1.urdf.xacro" />

    <!-- Import control_xacro -->
    <xacro:include filename="kuka_kr16_2.ros2_control.xacro" />


    <xacro:kuka_kr16_2_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
