<?xml version="1.0" encoding="UTF-8"?>
<robot xmlns:xacro ="http://wiki.ros.org/xacro" name="kuka_kr16_2">

    <xacro:include filename="$(find kuka_description)/urdf/description/kr16_2.xacro"/>
    <xacro:include filename="$(find kuka_description)/urdf/control/kuka.ros2_control.xacro"/>

    <link name="world"/>

    <xacro:kuka_arm prefix="kuka_2_"/>

    <joint name="world_to_kuka_2_base" type="fixed">
        <parent link="world"/>
        <child link="kuka_2_base_link"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <xacro:kuka_kr16_2_ros2_control prefix="kuka_2_"/>

    <xacro:arg name="controller_path" default="$(find omnilogix_controller)/config/kuka_2_controller.yaml"/>

    <gazebo>
        <plugin filename="libgz_ros2_control-system.so" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
            <parameters>$(arg controller_path)</parameters>
            <ros>
                <namespace>kuka_2</namespace>
            </ros>
        </plugin>
    </gazebo>

</robot>