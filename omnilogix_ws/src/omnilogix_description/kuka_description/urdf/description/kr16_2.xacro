<?xml version="1.0" ?>
<robot name="kuka_kr16_2" xmlns:xacro="http://wiki.ros.org/xacro">
  
  <xacro:macro name="kuka_arm" params="prefix">

    <!-- LINKS -->
    <!-- base link -->
    <link name="${prefix}base_link">
      <inertial>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <mass value="2"/>
        <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
      </inertial>
      <visual>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <geometry>
          <mesh filename="package://kuka_description/meshes/visual/base_link.dae"/>
        </geometry>
      </visual>
      <collision>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <geometry>
          <mesh filename="package://kuka_description/meshes/collision/base_link.stl"/>
        </geometry>
      </collision>
    </link>

    <!-- link 1 (A1) -->
    <link name="${prefix}link_1">
      <inertial>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <mass value="2"/>
        <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
      </inertial>
      <visual>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <geometry>
          <mesh filename="package://kuka_description/meshes/visual/link_1.dae"/>
        </geometry>
      </visual>
      <collision>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <geometry>
          <mesh filename="package://kuka_description/meshes/collision/link_1.stl"/>
        </geometry>
      </collision>
    </link>

    <!-- link 2 -->
    <link name="${prefix}link_2">
      <inertial>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <mass value="2"/>
        <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
      </inertial>
      <visual>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <geometry>
          <mesh filename="package://kuka_description/meshes/visual/link_2.dae"/>
        </geometry>
      </visual>
      <collision>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <geometry>
          <mesh filename="package://kuka_description/meshes/collision/link_2.stl"/>
        </geometry>
      </collision>
    </link>

    <!-- link 3 -->
    <link name="${prefix}link_3">
      <inertial>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <mass value="2"/>
        <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
      </inertial>
      <visual>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <geometry>
          <mesh filename="package://kuka_description/meshes/visual/link_3.dae"/>
        </geometry>
      </visual>
      <collision>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <geometry>
          <mesh filename="package://kuka_description/meshes/collision/link_3.stl"/>
        </geometry>
      </collision>
    </link>

    <!-- link 4 -->
    <link name="${prefix}link_4">
      <inertial>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <mass value="2"/>
        <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
      </inertial>
      <visual>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <geometry>
          <mesh filename="package://kuka_description/meshes/visual/link_4.dae"/>
        </geometry>
      </visual>
      <collision>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <geometry>
          <mesh filename="package://kuka_description/meshes/collision/link_4.stl"/>
        </geometry>
      </collision>
    </link>

    <!-- link 5 -->
    <link name="${prefix}link_5">
      <inertial>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <mass value="2"/>
        <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
      </inertial>
      <visual>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <geometry>
          <mesh filename="package://kuka_description/meshes/visual/link_5.dae"/>
        </geometry>
      </visual>
      <collision>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <geometry>
          <mesh filename="package://kuka_description/meshes/collision/link_5.stl"/>
        </geometry>
      </collision>
    </link>

    <!-- link 6 -->
    <link name="${prefix}link_6">
      <inertial>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <mass value="2"/>
        <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
      </inertial>
      <visual>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <geometry>
          <mesh filename="package://kuka_description/meshes/visual/link_6.dae"/>
        </geometry>
      </visual>
      <collision>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <geometry>
          <mesh filename="package://kuka_description/meshes/collision/link_6.stl"/>
        </geometry>
      </collision>
    </link>

    <!-- tool 0 -->
    <!-- This frame corresponds to the $FLANGE coordinate system in KUKA KRC controllers. -->
    <link name="${prefix}tool0"/>
    <!-- END LINKS -->

    <!-- JOINTS -->
    <!-- joint 1 (A1) -->
    <joint name="${prefix}joint_a1" type="revolute">
      <origin rpy="0 0 0" xyz="0 0 0.675"/>
      <parent link="${prefix}base_link"/>
      <child link="${prefix}link_1"/>
      <axis xyz="0 0 -1"/>
      <limit effort="400" lower="-3.22885911619" upper="3.22885911619" velocity="2.72271363311"/>
    </joint>

    <!-- joint 2 (A2) -->
    <joint name="${prefix}joint_a2" type="revolute">
      <origin rpy="0 0 0" xyz="0.26 0 0"/>
      <parent link="${prefix}link_1"/>
      <child link="${prefix}link_2"/>
      <axis xyz="0 1 0"/>
      <limit effort="400" lower="-2.70526034059" upper="0.610865238198" velocity="2.72271363311"/>
    </joint>

    <!-- joint 3 (A3) -->
    <joint name="${prefix}joint_a3" type="revolute">
      <origin rpy="0 0 0" xyz="0.68 0 0"/>
      <parent link="${prefix}link_2"/>
      <child link="${prefix}link_3"/>
      <axis xyz="0 1 0"/>
      <limit effort="300" lower="-2.26892802759" upper="2.68780704807" velocity="2.72271363311"/>
    </joint>

    <!-- joint 4 (A4) -->
    <joint name="${prefix}joint_a4" type="revolute">
      <origin rpy="0 0 0" xyz="0.67 0 -0.035"/>
      <parent link="${prefix}link_3"/>
      <child link="${prefix}link_4"/>
      <axis xyz="-1 0 0"/>
      <limit effort="100" lower="-6.10865238198" upper="6.10865238198" velocity="5.75958653158"/>
    </joint>

    <!-- joint 5 (A5) -->
    <joint name="${prefix}joint_a5" type="revolute">
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <parent link="${prefix}link_4"/>
      <child link="${prefix}link_5"/>
      <axis xyz="0 1 0"/>
      <limit effort="100" lower="-2.26892802759" upper="2.26892802759" velocity="5.75958653158"/>
    </joint>

    <!-- joint 6 (A6) -->
    <joint name="${prefix}joint_a6" type="revolute">
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <parent link="${prefix}link_5"/>
      <child link="${prefix}link_6"/>
      <axis xyz="-1 0 0"/>
      <limit effort="50" lower="-6.10865238198" upper="6.10865238198" velocity="10.7337748998"/>
    </joint>

    <!-- tool frame - fixed frame -->
    <joint name="${prefix}joint_a6-tool0" type="fixed">
      <parent link="${prefix}link_6"/>
      <child link="${prefix}tool0"/>
      <origin rpy="0 1.57079632679 0" xyz="0.158 0 0"/>
    </joint>

    <!-- END JOINTS -->
    <!-- ROS base_link to KUKA $ROBROOT coordinate system transform -->
    <link name="${prefix}base"/>

    <joint name="${prefix}base_link-base" type="fixed">
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <parent link="${prefix}base_link"/>
      <child link="${prefix}base"/>
    </joint>

  </xacro:macro>
 
</robot>
